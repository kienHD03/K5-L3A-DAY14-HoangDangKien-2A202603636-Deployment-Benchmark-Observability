# Server & Environment
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authentication (set real secret via environment / dashboard, never commit .env)
AGENT_API_KEY=your-secret-api-key-change-me

# Redis (rate limiting & cost guard state)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Cost Protection
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
